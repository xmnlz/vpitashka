{
  "name": "vpitashka",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "mig": "bun drizzle-kit generate:pg",
    "lint": "bun tsc --noEmit",
    "dev": "bun lint && NODE_ENV=development bun run src/main.ts",
    "start:prod": "pnpm build && NODE_ENV=production node build/main.js",
    "copyfiles": "copyfiles -u 1 src/**/*.html src/**/*.png build/",
    "clean": "rm -rf build/",
    "build:bun": "bun build ./src/**/*.ts --target=bun --no-bundle --outdir=build",
    "build": "pnpm clean && tsc && tsc-alias && pnpm copyfiles"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@discordx/importer": "^1.3.1",
    "@discordx/pagination": "^3.5.4",
    "@types/node-schedule": "^2.1.7",
    "discord.js": "^14.15.3",
    "discordx": "^11.12.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "humanize-duration": "^3.32.1",
    "i18next": "^23.12.3",
    "mitata": "^0.1.11",
    "moment": "^2.30.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.12.0",
    "puppeteer": "^23.0.2",
    "reflect-metadata": "^0.2.2",
    "tslog": "^4.9.3",
    "tsyringe": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@types/humanize-duration": "^3.27.4",
    "@types/node": "^22.2.0",
    "@types/pg": "^8.11.6",
    "copyfiles": "^2.4.1",
    "drizzle-kit": "^0.24.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "trustedDependencies": [
    "es5-ext",
    "esbuild",
    "puppeteer"
  ]
}
